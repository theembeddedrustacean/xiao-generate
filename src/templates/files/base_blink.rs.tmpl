#![no_std]
#![no_main]

use esp_hal::gpio::{Level, Output, OutputConfig};
use esp_hal::main;
use esp_hal::time::{Duration, Instant};

#[panic_handler]
fn panic(_: &core::panic::PanicInfo) -> ! {
    loop {}
}

// This creates a default app-descriptor required by the esp-idf bootloader.
esp_bootloader_esp_idf::esp_app_desc!();

#[main]
fn main() -> ! {
    // Generated by xiao-generate — base blink template.
    let peripherals = esp_hal::init(esp_hal::Config::default());

    // Onboard user LED, initialised to its OFF level (from the variant's
    // documented polarity); the loop then toggles it. Uses a stable busy-wait
    // delay (esp_hal::time) so the base scaffold needs no unstable features.
    let mut led = Output::new(
        peripherals.GPIO{{LED_GPIO}},
        Level::{{LED_INIT_LEVEL}},
        OutputConfig::default(),
    );

    loop {
        led.toggle();
        let start = Instant::now();
        while start.elapsed() < Duration::from_millis(500) {}
    }
}
