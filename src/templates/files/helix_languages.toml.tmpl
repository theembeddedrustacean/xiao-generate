# Helix rust-analyzer settings for this project.
#
# rust-analyzer defaults to `cargo check --all-targets`, which builds the test
# target. The `test` crate does not exist for bare-metal targets (nor for the
# esp-idf `build-std` set, which is `["std", "panic_abort"]`), so without these
# the editor reports
#
#     error[E0463]: can't find crate for `test`
#
# against a project that `cargo build` compiles perfectly. See rust-analyzer.toml
# in the project root for the full rationale.
#
# Helix merges a project-local `.helix/languages.toml` over its own built-in
# language configuration, and the `config` table of a `[language-server.<name>]`
# entry is sent to the server as its LSP initialization options — which is the
# delivery path that actually suppresses this diagnostic (a project-local
# `rust-analyzer.toml` alone does not, as of rust-analyzer 1.97.1).

[[language]]
name = "rust"

[language-server.rust-analyzer.config]
cargo.allTargets = false
check.allTargets = false
