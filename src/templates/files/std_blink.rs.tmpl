//! XIAO onboard-LED blink — std / ESP-IDF (`esp-idf-hal`).
//!
//! Generated by xiao-generate (ESP `esp-idf` std stack). Adapted verbatim from
//! esp-idf-hal's own `examples/blinky.rs` (upstream, D4 — sourced, not authored);
//! the only change is the GPIO pin, remapped to this XIAO variant's onboard user
//! LED. The error type is `esp_idf_hal::sys::EspError` (upstream uses
//! `anyhow::Result`) so the project needs no extra dependency beyond the pinned
//! esp-idf-hal.

use esp_idf_hal::delay::FreeRtos;
use esp_idf_hal::gpio::*;
use esp_idf_hal::peripherals::Peripherals;

fn main() -> Result<(), esp_idf_hal::sys::EspError> {
    // It is necessary to call this function once to link ESP-IDF runtime patches.
    esp_idf_hal::sys::link_patches();

    let peripherals = Peripherals::take()?;
    let mut led = PinDriver::output(peripherals.pins.gpio{{LED_GPIO}})?;

    loop {
        led.set_high()?;
        // Sleep so the task watchdog isn't triggered.
        FreeRtos::delay_ms(1000);

        led.set_low()?;
        FreeRtos::delay_ms(1000);
    }
}
