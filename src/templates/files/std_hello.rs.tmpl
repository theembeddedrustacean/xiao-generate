//! XIAO log-hello — std / ESP-IDF (`esp-idf-svc` + `esp-idf-hal`).
//!
//! Generated by xiao-generate (ESP `esp-idf` std stack). This variant has no
//! onboard user LED, so we greet over the ESP-IDF logging facility instead.
//! Mirrors esp-idf-template's own default `main.rs` (`link_patches` +
//! `EspLogger::initialize_default`), extended with a periodic log loop; the
//! delay comes from the pinned esp-idf-hal (`FreeRtos`).

use esp_idf_hal::delay::FreeRtos;

fn main() {
    // Necessary once to link ESP-IDF runtime patches. See
    // https://github.com/esp-rs/esp-idf-template/issues/71
    esp_idf_svc::sys::link_patches();
    // Bind the `log` crate to the ESP-IDF logging facilities.
    esp_idf_svc::log::EspLogger::initialize_default();

    let mut tick: u32 = 0;
    loop {
        log::info!("Hello from xiao-generate! tick {}", tick);
        tick = tick.wrapping_add(1);
        FreeRtos::delay_ms(1000);
    }
}
